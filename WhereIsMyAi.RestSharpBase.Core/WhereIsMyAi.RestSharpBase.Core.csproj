<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project-agnostic RestSharp base: no API under test, no test framework. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="RestSharp" Version="114.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WhereIsMyAi.RestSharpBase.Core.UnitTests" />
  </ItemGroup>

</Project>
